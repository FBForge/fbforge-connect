# Keep all source and formatter input identical on Windows and Unix checkouts.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
# Preserve the upstream Maven wrapper's committed CRLF bytes.
engine/mvnw.cmd -text
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.woff binary
*.woff2 binary
*.pdf binary
*.jar binary
