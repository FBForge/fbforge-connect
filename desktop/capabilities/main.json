    "allow-begin-content", "allow-append-content", "allow-discard-content",
    "allow-prepare-send", "allow-execute-send", "allow-cancel-send", "allow-send-state",
    "allow-reply-target", "allow-prepare-reply", "allow-execute-reply", "allow-cancel-reply", "allow-reply-state",
    "allow-list-submissions", "allow-load-submission",
    "allow-verify-submission", "allow-list-received-contents", "allow-read-received-content", "allow-discard-received",
    "allow-verify-reply", "allow-list-received-reply-contents", "allow-read-received-reply-content", "allow-discard-received-reply",
    "allow-prepare-receipt", "allow-execute-receipt", "allow-cancel-receipt", "allow-receipt-state",
